# HomeStack environment — copy to .env and adjust. NEVER commit the real .env.
# Local-network only; no public exposure (Security §14). LAN-trusted HTTPS is terminated by the
# separately-running Nginx Proxy Manager (Let's Encrypt via Cloudflare DNS Challenge) and Pi-hole
# local DNS — neither lives in this repo/compose file. See HOMESTACK_PUBLIC_HOSTNAME below for
# what HomeStack itself needs to know about that hostname.

# --- PostgreSQL ---
POSTGRES_DB=homestack
POSTGRES_USER=homestack
POSTGRES_PASSWORD=change-me-in-real-env
POSTGRES_HOST=homestack-postgres
POSTGRES_PORT=5432

# --- Django ---
# NOTE: this value no longer decides what production runs. docker-compose.yml pins
# DJANGO_SETTINGS_MODULE=config.settings.prod in the backend service's `environment:` block, which
# takes precedence over this file, and docker-compose.dev.yml pins config.settings.dev. It is kept
# here for tooling run outside Compose (a local virtualenv, an editor, a one-off script).
#
# config.settings.dev  — hot reload, permissive hosts, DEBUG=1.
# config.settings.prod — the live home server behind Nginx Proxy Manager: DEBUG=0 (errors go to
#   `docker logs homestack-backend`, not the browser), trusts the proxy's X-Forwarded-Proto,
#   secure cookies, and WhiteNoise serving the collected /static/ so Django admin stays styled.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1
# Includes the compose service name so the frontend dev proxy (changeOrigin) is accepted.
# On a real server you MUST add its hostname / LAN IP here, e.g. ...,moose-server,192.168.1.125
# — and, once Nginx Proxy Manager is in front, the public hostname too, e.g.
# ...,homestack.moosesoftwares.com
# In dev settings this also auto-adds the CSRF-trusted origin http://<host>:5173 for each entry,
# so adding your server IP here is what makes saving (POST/PATCH/DELETE) work from the browser.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,homestack-backend

# Django 4+ checks the browser Origin header on writes against CSRF_TRUSTED_ORIGINS. dev settings
# derive these from DJANGO_ALLOWED_HOSTS automatically; prod derives https://<hostname> from
# HOMESTACK_PUBLIC_HOSTNAME below. Set this only to add further origins. Comma-separated
# scheme://host[:port].
# DJANGO_CSRF_TRUSTED_ORIGINS=https://homestack.moosesoftwares.com

# Secure cookies need HTTPS. Set to 0 for a plain-HTTP LAN deployment (prod settings only)
# or login will silently fail. Once Nginx Proxy Manager/TLS is in place, leave this at 1.
DJANGO_SECURE_COOKIES=1

# --- HTTPS on the LAN (Nginx Proxy Manager + Pi-hole, Security §14) ---
# The hostname NPM requests a certificate for and proxies to this container. Also add it to
# DJANGO_ALLOWED_HOSTS/DJANGO_CSRF_TRUSTED_ORIGINS above. The Cloudflare API token for NPM's DNS
# Challenge lives in NPM's own SSL credential store, not here — HomeStack never sees it.
HOMESTACK_PUBLIC_HOSTNAME=homestack.moosesoftwares.com

# Nginx Proxy Manager must be able to reach HomeStack's frontend/backend over Docker networking in
# production. This is the existing NPM Compose network on the live server; override only if NPM is
# moved to a differently named Docker network.
NPM_DOCKER_NETWORK=proxy

# --- Development host port mappings (left side is the port on your machine) ---
# Production docker-compose.yml no longer publishes HomeStack app/database ports to the LAN.
# docker-compose.dev.yml uses these values to keep local development convenient.
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_HOST_PORT=5432

# --- Gunicorn (production backend only; see backend/gunicorn.conf.py) ---
# Defaults suit one household on a home server. Raise workers only if the server has cores to
# spare — each one is a full Django process.
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info
